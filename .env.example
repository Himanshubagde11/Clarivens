# ============================================================
# CLARIVENS — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to source control.
# In production, use Azure Key Vault for all secrets.
# ============================================================

# ----- APPLICATION ------------------------------------------
APP_ENV=development
# Options: development | staging | production

APP_NAME=Clarivens AI Analytics Platform

# ----- DATABASE ---------------------------------------------
# Local development (SQLite):
DATABASE_URL=sqlite:///./clarivens.db

# Production (Azure PostgreSQL Flexible Server):
# DATABASE_URL=postgresql+psycopg2://username:password@your-server.postgres.database.azure.com:5432/clarivens?sslmode=require

# ----- URLS -------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Comma-separated allowed CORS origins:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ----- AUTHENTICATION (JWT local / Entra External ID) -------
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Token expiry in minutes:
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Microsoft Entra External ID (production):
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# ----- AI / GEMINI ------------------------------------------
# Server-side only — never expose to browser
# Revoke the old key and generate a new one at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- AZURE BLOB STORAGE -----------------------------------
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=clarivens-data
AZURE_STORAGE_CONNECTION_STRING=

# Storage backend: local | azure
STORAGE_BACKEND=local

# Maximum upload file size in megabytes:
MAX_UPLOAD_SIZE_MB=50

# ----- AZURE SERVICE BUS ------------------------------------
AZURE_SERVICE_BUS_CONNECTION=
AZURE_SERVICE_BUS_QUEUE=clarivens-jobs

# Job backend: memory | azure_service_bus
JOB_BACKEND=memory

# ----- AZURE KEY VAULT --------------------------------------
AZURE_KEY_VAULT_URL=

# ----- MONITORING -------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ----- PAYMENT ----------------------------------------------
# Payment mode: mock | stripe | razorpay
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
# ============================================================
